# What this installation has available, as opposed to what a campaign wants. Copy and
# fill in the parts you have:
#
#     cp lab.env.template lab.env
#
# The copy is not tracked by git. Every campaign's run.sh sources it, and a campaign
# that wants something else sets it after that, so these are the lab's defaults rather
# than its rules. Anything already in the environment wins over both.
#
# Every setting here is listed with its default in docs/settings.md.

# --- A second model, available for reviewing a cycle's write-up (docs/llm.md) --------
# This says what this installation can reach. Whether a run uses a critic is decided by
# the campaign or on the command line -- CRITIC_MODEL=auto ./run.sh -- because it costs
# a couple of minutes a cycle and is not always wanted.

# Where that model is served. A gateway of your own (LiteLLM and the like) or a service
# that speaks the Messages API.
export CRITIC_BASE_URL="${CRITIC_BASE_URL:-}"

# Its credential, only if the gateway wants a different one from the agent's. Left
# empty, the critic uses whatever Claude Code is already configured with, which is the
# same credential whenever the second model is served from the same place. Never write
# a key here: everyone using this checkout shares this file.
export CRITIC_API_KEY_FILE="${CRITIC_API_KEY_FILE:-}"

# How to start that gateway, if the lab runs one of its own. Used at preflight only
# when a critic was asked for and nothing is already answering, so leaving a gateway
# running by hand works exactly the same.
export CRITIC_GATEWAY_START="${CRITIC_GATEWAY_START:-}"

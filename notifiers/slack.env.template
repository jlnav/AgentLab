# Slack settings for this lab. Copy this file and fill it in:
#
#     cp notifiers/slack.env.template notifiers/slack.env
#
# The copy is not tracked by git. Every setting below is an environment variable,
# and a value already in the environment wins over the one here. Full list with
# defaults: docs/settings.md.

# Channel the bridge reads. Right-click the channel in Slack -> Copy link; the
# C... in that URL is the ID.
SLACK_CHANNEL="${SLACK_CHANNEL:-}"

# The bot user as people mention it in the channel. Used when a mention is typed
# without Slack autocomplete.
SLACK_BOT_NAME="${SLACK_BOT_NAME:-@cas_agent}"

# Credentials, kept outside the repository.
SLACK_WEBHOOK_FILE="${SLACK_WEBHOOK_FILE:-$HOME/.slack_webhook}"
SLACK_BOT_TOKEN_FILE="${SLACK_BOT_TOKEN_FILE:-$HOME/.slack_bot_token}"

# Seconds between channel checks. conversations.history is Slack Tier 3 (50+ req/min),
# so 5s is well inside the limit and is what end-to-end latency mostly depends on.
SLACK_FETCH_POLL="${SLACK_FETCH_POLL:-5}"

# Forward every channel message to the secretary, so people do not have to @-mention
# it, and let it judge which are for it. Mentions only, when the secretary is down.
SLACK_READ_ALL="${SLACK_READ_ALL:-false}"

# Campaigns the secretary may start and stop on request, space-separated. Empty means
# it can do neither. A campaign is reachable from Slack only by being named here.
SLACK_CAMPAIGNS="${SLACK_CAMPAIGNS:-}"

# The script that posts a message. Point this at another transport's script to
# send somewhere other than Slack; empty uses framework/slack_notify.sh.
NOTIFY_SCRIPT="${NOTIFY_SCRIPT:-}"
